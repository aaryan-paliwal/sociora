# Sociora — AI Social Content Studio Environment Variables

# ==========================================
# Google Gemini AI Text Configuration
# ==========================================
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
# Verified fast Flash text model identifier
GEMINI_MODEL=gemini-3.8-flash

# ==========================================
# AI Visual / Image Generation Configuration
# ==========================================
# API key for image generation (defaults to GEMINI_API_KEY if shared)
IMAGE_GENERATION_API_KEY=
# Verified Gemini Image generation model identifier
IMAGE_GENERATION_MODEL=gemini-3.1-flash-image

# ==========================================
# Supabase Database Configuration
# ==========================================
# Project URL and public anonymous key from Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Service Role Key (for secure backend operations)
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Application Configuration
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
